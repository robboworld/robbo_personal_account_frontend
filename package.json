{
  "name": "react-project-template",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "webpack serve --open --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "eslint:test": "eslint src --ext .js,.jsx",
    "eslint:fix": "eslint --fix src --ext .js,.jsx",
    "i18n:check": "node scripts/i18n-check.js",
    "test": "jest",
    "cypress": "start-server-and-test start http://localhost:3000 cypress:open",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:test": "start-server-and-test start http://localhost:3000 cypress:run",
    "landing:restore": "sh scripts/restore-landing.sh",
    "landing:restore:legacy": "sh scripts/restore-landing-legacy.sh",
    "docker:rebuild": "docker compose build web && docker compose up -d --force-recreate web"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^axios$": "axios/dist/node/axios.cjs"
    }
  },
  "dependencies": {
    "@apollo/client": "^3.6.9",
    "@cospired/i18n-iso-languages": "4.2.0",
    "@emotion/styled": "^11.10.4",
    "antd": "5.x",
    "axios": "^1.20.0",
    "classnames": "^2.3.2",
    "country-flag-icons": "^1.5.0",
    "express": "^4.21.2",
    "formik": "^2.0.3",
    "framer-motion": "6.5.1",
    "graphql": "^16.6.0",
    "i18n-iso-countries": "4.3.1",
    "libphonenumber-js": "^1.11.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-icons": "^4.3.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intl": "^6.2.7",
    "react-loader-spinner": "^3.1.4",
    "react-phone-number-input": "^3.4.9",
    "react-redux": "^7.1.1",
    "react-router-dom": "^6.4.5",
    "react-select": "^5.3.2",
    "react-toastify": "8.1.0",
    "react-useportal": "^1.0.17",
    "redux": "^4.0.4",
    "redux-actions": "^2.6.5",
    "redux-saga": "^1.1.3",
    "styled-components": "^5.3.5",
    "yup": "^0.27.0"
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/eslint-parser": "^7",
    "@babel/plugin-transform-runtime": "^7",
    "@babel/preset-env": "^7",
    "@babel/preset-react": "^7",
    "@babel/runtime": "^7",
    "@commitlint/cli": "^8.2.0",
    "@commitlint/config-conventional": "^8.2.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9",
    "babel-plugin-styled-components": "^1.10.6",
    "css-loader": "^7",
    "cypress": "^3.6.0",
    "dotenv-webpack": "^8",
    "eslint": "^8.57",
    "eslint-config-prettier": "^9",
    "eslint-config-standard": "^17",
    "eslint-config-standard-react": "^13",
    "eslint-plugin-cypress": "^2",
    "eslint-plugin-import": "^2",
    "eslint-plugin-n": "^16",
    "eslint-plugin-promise": "^6",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^4",
    "html-webpack-plugin": "^5",
    "husky": "^3.0.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^9.4.2",
    "prettier": "^1.18.2",
    "start-server-and-test": "^1.10.6",
    "style-loader": "^4",
    "terser-webpack-plugin": "^5",
    "webpack": "^5",
    "webpack-cli": "^5",
    "webpack-dev-server": "^5",
    "webpack-merge": "^6"
  }
}
