{
  "name": "react-project-template",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "prepare": "husky",
    "dev": "webpack serve --open --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "eslint:test": "eslint src cypress cypress.config.js",
    "eslint:fix": "eslint --fix src",
    "i18n:check": "node scripts/i18n-check.js",
    "test": "jest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "yarn build && PORT=3030 start-server-and-test start http://localhost:3030 cypress:run",
    "landing:restore": "sh scripts/restore-landing.sh",
    "landing:restore:legacy": "sh scripts/restore-landing-legacy.sh",
    "docker:rebuild": "docker compose build web && docker compose up -d --force-recreate web",
    "docker:dev": "docker compose stop web; docker run --rm -it -u $(id -u):$(id -g) -e HOME=/tmp -v \"$PWD\":/app -w /app -p 3030:3030 node:22-alpine npx webpack serve --config webpack.dev.js",
    "docker:check": "docker run --rm -u $(id -u):$(id -g) -e HOME=/tmp -v \"$PWD\":/app -w /app node:22-alpine sh -c 'yarn -s eslint:test && yarn -s i18n:check && yarn -s test --silent'"
  },
  "resolutions": {
    "@babel/runtime": "^7.26.10",
    "@babel/traverse": "^7.23.2",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "yaml": "^1.10.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^axios$": "axios/dist/node/axios.cjs",
      "\\.css$": "<rootDir>/src/__mocks__/styleMock.js",
      "^@ant-design/colors(?:/es)?(/.*)?$": "<rootDir>/node_modules/@ant-design/colors/lib$1"
    },
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "default"
      ]
    },
    "setupFiles": [
      "<rootDir>/src/setupTests.js"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6",
    "@apollo/client": "^4",
    "@cospired/i18n-iso-languages": "4.2.0",
    "@emotion/styled": "^11.10.4",
    "antd": "^6",
    "axios": "^1.20.0",
    "classnames": "^2.3.2",
    "country-flag-icons": "^1.5.0",
    "express": "^4.21.2",
    "formik": "^2.4.9",
    "framer-motion": "6.5.1",
    "graphql": "^16.14.2",
    "i18n-iso-countries": "4.3.1",
    "libphonenumber-js": "^1.11.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-icons": "^4.3.1",
    "react-infinite-scroll-component": "^6.1.0",
    "react-intl": "^6",
    "react-loader-spinner": "^3.1.4",
    "react-phone-number-input": "^3.4.9",
    "react-redux": "^9",
    "react-router-dom": "^7",
    "react-select": "^5.3.2",
    "react-toastify": "8.1.0",
    "react-useportal": "^1.0.17",
    "redux": "^5",
    "redux-actions": "^2.6.5",
    "redux-saga": "^1.5.1",
    "rxjs": "^7",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@babel/cli": "^7",
    "@babel/core": "^7",
    "@babel/eslint-parser": "^7",
    "@babel/plugin-transform-runtime": "^7",
    "@babel/preset-env": "^7",
    "@babel/preset-react": "^7",
    "@babel/runtime": "^7",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9",
    "babel-plugin-styled-components": "^1.10.6",
    "css-loader": "^7",
    "cypress": "^16.1.1",
    "dotenv-webpack": "^8",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-cypress": "^6",
    "eslint-plugin-import": "^2",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "html-webpack-plugin": "^5",
    "husky": "^9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15",
    "neostandard": "^0.14",
    "prettier": "^1.18.2",
    "start-server-and-test": "^3",
    "style-loader": "^4",
    "terser-webpack-plugin": "^5",
    "webpack": "^5",
    "webpack-cli": "^5",
    "webpack-dev-server": "^5",
    "webpack-merge": "^6"
  }
}
