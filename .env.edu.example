# Prod deployment — build-time env (yarn build / docker compose build web).
# Runbook: architecture/runbooks/prod-edu-robbo-lk-rs.md

LK_SSO_WITH_LMS_ENABLED=true
BACKEND_URL=https://lk.example.com

LMS_URL=https://lms.example.com

SCRATCH_EDITOR_URL=https://scratch.example.com/
SCRATCH_PLAYER_URL=https://scratch.example.com/player.html

# Other sites allowed as return_to after login/logout (comma-separated), e.g. a legacy RS host.
# Keep in sync with OIDC_RETURN_TO_ORIGINS in backend/.env.
# OIDC_RETURN_TO_ORIGINS=https://scratch.example.org

OIDC_CLIENT_ID=lk-web
OIDC_SCOPES=email profile user_id
OIDC_REDIRECT_URI=https://lk.example.com/auth/oidc/callback
