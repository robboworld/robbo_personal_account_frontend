LK_SSO_WITH_LMS_ENABLED=true

# Prod deployment: см. frontend/.env.edu.example и architecture/runbooks/prod-edu-robbo-lk-rs.md
# По умолчанию API — тот же hostname, порт :8080. Override:
# BACKEND_URL=https://lk.example.com
# BACKEND_PORT=8080

LMS_URL=http://local.overhang.io

# Редактор Scratch — единственная точка настройки origin (local → prod).
# Preview/player — URL из RobboScratch (локально :5001 или prod scratch.example.com)
SCRATCH_EDITOR_URL=http://localhost:8601/
SCRATCH_PLAYER_URL=http://localhost:5001/player.html

# IdP: Tutor (см. backend/.env.tutor.example). Mock: ./setup.sh --oidc-mock
OIDC_ISSUER=http://localhost:8081/default
OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8081/default/authorize
OIDC_TOKEN_ENDPOINT=http://localhost:8081/default/token
OIDC_JWKS_URI=http://localhost:8081/default/jwks
OIDC_USERINFO_ENDPOINT=http://localhost:8081/default/userinfo
OIDC_CLIENT_ID=lk-web
OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
# Open edX DOT: scopes отдельными строками в admin; в env — через пробел (без openid):
OIDC_SCOPES=email profile user_id
OIDC_LOGOUT_ENDPOINT=
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3030/?logged_out=1
